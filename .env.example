# Copy to .env on the runner machine. NEVER commit .env.
# ---------------------------------------------------------------------------

# The HUB API — base URL + key come from the Chapter dev (docs/DEV_QUESTIONS.md Q1).
HUB_BASE_URL=https://hub.hellochapter.com
HUB_API_KEY=

# Polycam: directory holding the persistent, logged-in Playwright browser
# profile. Seed it once interactively:  python -m src.polycam_export --login
POLYCAM_PROFILE_DIR=./polycam-profile

# Alerts (unmatched deal / oversize file / decoded failure). Leave SMTP vars
# empty to fall back to state/alerts.log only.
ALERT_EMAIL_TO=eran@hellochapter.com
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

# F2 (workstation only): how to reach the AUTOM8LABS Revit MCP connector.
# transport: "sse" (url) or "stdio" (command). Verify on the workstation.
REVIT_MCP_TRANSPORT=sse
REVIT_MCP_URL=http://127.0.0.1:8765/sse
REVIT_MCP_COMMAND=
